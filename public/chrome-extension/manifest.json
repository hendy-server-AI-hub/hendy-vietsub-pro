{
  "manifest_version": 3,
  "name": "Hendy Vietsub Pro - AI Video Translator & Speech Recognition",
  "short_name": "HendyVietsub",
  "version": "1.2.0",
  "description": "Dịch phụ đề trực tiếp trên mọi trang web (YouTube, Netflix), nhận diện âm thanh giọng nói và đồng bộ Hendy Studio Pro.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hendy Vietsub Pro Extension"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
